# Test environment variables (loaded by "yamf test")
# Copy from run-tests.js / test.sh for full integration runs

ENVIRONMENT=local
YAMF_REGISTRY_URL=http://localhost:30000
YAMF_GATEWAY_URL=http://localhost:30100
YAMF_REGISTRY_TOKEN=dev-test-token-12345
ADMIN_USER=testadmin
ADMIN_PASS=testsecret123
LOG_LEVEL=info
YAMF_LOG_QUIET_GROUPS=true
LOG_INCLUDE_LINES=true
LOG_EXCLUDE_FULL_PATH_IN_LOG_LINES=true
YAMF_TEST_QUIET_PASSES=true
