{
  "name": "@yamf/cli",
  "version": "0.4.0",
  "type": "module",
  "description": "Command-line interface for yamf",
  "main": "src/index.js",
  "bin": {
    "yamf": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./pm3": "./src/lib/pm3.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "yamf test -d .",
    "test:hash": "yamf test -d . -f bundle-hash",
    "test:build-deploy": "yamf test -d . -f cli-build-deploy"
  },
  "files": [
    "src/cli.js",
    "src/commands",
    "src/example",
    "src/index.js",
    "src/lib"
  ],
  "keywords": [
    "yamf",
    "cli"
  ],
  "license": "MIT",
  "author": "Matthew C Brumagin",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcbrumagin/yamf"
  },
  "peerDependencies": {
    "@yamf/test": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yamf/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@yamf/test": "workspace:*"
  },
  "dependencies": {
    "@yamf/core": "workspace:*",
    "@yamf/services-cache": "workspace:*",
    "@yamf/services-deploy-router": "workspace:*",
    "@yamf/services-pm3": "workspace:*",
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.12"
  }
}
