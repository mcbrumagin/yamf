{
  "name": "@yamf/shared",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared utilities for YAMF - truly isomorphic code that works in both browser and Node.js",
  "main": "src/index.js",
  "homepage": "https://github.com/mcbrumagin/yamf",
  "scripts": {
    "test": "yamf test -d ."
  },
  "exports": {
    ".": "./src/index.js",
    "./validator": "./src/validator/index.js",
    "./validators": "./src/validators.js",
    "./utils": "./src/utils.js",
    "./security": "./src/security/xss.js",
