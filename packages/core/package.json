{
  "name": "@yamf/core",
  "version": "1.0.0",
  "type": "module",
  "description": "A lightweight, zero-dependency microservices framework for Node.js with built-in service discovery, api gateway, pub/sub messaging, HTTP routing, and load balancing.",
  "main": "src/index.js",
  "homepage": "https://github.com/mcbrumagin/yamf",
  "exports": {
    ".": "./src/index.js",
    "./env-config": "./src/shared/env-config.js",
    "./crypto": "./src/shared/crypto.js",
    "./contract-compatibility": "./src/service/contract-compatibility.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "microservices",
    "api gateway",
    "service discovery",
    "pub/sub",
    "HTTP routing",
    "load balancing",
    "zero-dependency"
  ],
  "scripts": {
    "test": "yamf test -d .",
    "test:all": "yamf test -d . --include-e2e"
  },
  "files": [
    "src",
    "yamf.cjs",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Matthew C Brumagin",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcbrumagin/yamf"
  },
  "peerDependencies": {
    "@yamf/client": "workspace:*",
    "@yamf/shared": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yamf/client": {
      "optional": true
    },
    "@yamf/shared": {
      "optional": true
    }
  },
  "devDependencies": {
    "@yamf/client": "workspace:*",
    "@yamf/cli": "workspace:*",
    "@yamf/shared": "workspace:*",
    "@yamf/test": "workspace:*",
    "form-data": "^4.0.4"
  }
}
