{
  "name": "@yamf/client",
  "version": "1.0.0",
  "type": "module",
  "description": "Isomorphic HTML-as-JavaScript library with conditional exports for browser and server",
  "main": "src/index.js",
  "homepage": "https://github.com/mcbrumagin/yamf",
  "exports": {
    ".": "./src/index.js",
    "./element": "./src/element.js",
    "./elements": "./src/elements.js",
    "./html-tags": "./src/html-tags.js",
    "./state": "./src/state.js",
    "./client-init": "./src/client-init.js",
    "./client-utils": "./src/client-utils.js",
    "./patch-dom": "./src/patch-dom.js",
    "./event-source": "./src/event-source.js",
    "./ssr-render": "./src/ssr-render.js",
    "./ssr-hydrate": "./src/ssr-hydrate.js",
    "./render-context": "./src/render-context.js",
    "./dev-hmr": "./src/dev-hmr.js",
    "./vite-plugin-yamf-dev": "./src/vite-plugin-yamf-dev.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "html",
    "isomorphic",
    "ssr",
    "client-side",
    "reactive",
    "morphdom"
  ],
  "scripts": {
    "test": "yamf test -d .",
    "test:all": "yamf test -d . --include-e2e"
  },
  "dependencies": {
    "@yamf/shared": "workspace:*",
    "morphdom": "^2.7.8"
  },
  "peerDependencies": {
    "@yamf/core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yamf/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@yamf/cli": "workspace:*",
    "@yamf/core": "workspace:*",
    "@yamf/test": "workspace:*",
    "jsdom": "^24.1.3"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Matthew C Brumagin",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcbrumagin/yamf"
  }
}
